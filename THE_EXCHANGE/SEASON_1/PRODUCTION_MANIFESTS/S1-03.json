  "audio": {
    "dialogue": [
      {
        "lineId": "S1-03-L001",
        "cue": "KAI",
        "voiceId": null,
        "text": "Before you say it—",
        "direction": "as Gideon reaches the bottom step",
        "characters": 18
      },
      {
        "lineId": "S1-03-L002",
        "cue": "GIDEON",
        "voiceId": null,
        "text": "Not tonight, Kai.",
        "direction": null,
        "characters": 17
      },
      {
        "lineId": "S1-03-L003",
        "cue": "KAI",
        "voiceId": null,
        "text": "And there it is.",
        "direction": null,
        "characters": 16
      },
      {
        "lineId": "S1-03-L004",
        "cue": "KAI",
        "voiceId": null,
        "text": "I'm not asking to come in. I know where I stand. Out here, apparently, in a very good waistcoat.",
        "direction": "beat",
        "characters": 96
      },
      {
        "lineId": "S1-03-L005",
        "cue": "KAI",
        "voiceId": null,
        "text": "It isn't for me. That's the only reason I'm standing here.",
        "direction": null,
        "characters": 58
      },
      {
        "lineId": "S1-03-L006",
        "cue": "GIDEON",
        "voiceId": null,
        "text": "Go home, Kai.",
        "direction": null,
        "characters": 13
      },
      {
        "lineId": "S1-03-L007",
        "cue": "KAI",
        "voiceId": null,
        "text": "Working on it.",
        "direction": "a small, dry smile",
        "characters": 14
      },
      {
        "lineId": "S1-03-L008",
        "cue": "ROYCE",
        "voiceId": null,
        "text": "Gideon Shaw. I was hoping it'd be you. Five minutes with Lockwood. She'll thank you for it.",
        "direction": "all charm",
        "characters": 91
      },
      {
        "lineId": "S1-03-L009",
        "cue": "GIDEON",
        "voiceId": null,
        "text": "There's a door for that, Royce. It isn't this one.",
        "direction": null,
        "characters": 50
      },
      {
        "lineId": "S1-03-L010",
        "cue": "SLOANE",
        "voiceId": null,
        "text": "My father's right hand. My left. Has never once knocked.",
        "direction": null,
        "characters": 56
      },
      {
        "lineId": "S1-03-L011",
        "cue": "SLOANE",
        "voiceId": null,
        "text": "Runs the most popular room in the city. Would like mine.",
        "direction": null,
        "characters": 56
      },
      {
        "lineId": "S1-03-L012",
        "cue": "ROYCE",
        "voiceId": null,
        "text": "Worth a try.",
        "direction": null,
        "characters": 12
      },
      {
        "lineId": "S1-03-L013",
        "cue": "ROYCE",
        "voiceId": null,
        "text": "When you get tired of standing on her stairs, mine are wider.",
        "direction": "lifting a glass from a passing tray",
        "characters": 61
      }
    ],
    "dialogueCharacters": 558,
