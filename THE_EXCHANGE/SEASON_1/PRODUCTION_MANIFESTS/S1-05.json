        "characters": 4
      },
      {
        "lineId": "S1-05-L003",
        "cue": "SLOANE",
        "voiceId": null,
        "text": "He came here.",
        "direction": null,
        "characters": 13
      },
      {
        "lineId": "S1-05-L004",
        "cue": "GIDEON",
        "voiceId": null,
        "text": "Stayed on the steps. Didn't ask to come in.",
        "direction": null,
        "characters": 43
      },
      {
        "lineId": "S1-05-L005",
        "cue": "GIDEON",
        "voiceId": null,
        "text": "Good waistcoat.",
        "direction": "beat",
        "characters": 15
      },
      {
        "lineId": "S1-05-L006",
        "cue": "SLOANE",
        "voiceId": null,
        "text": "He would.",
        "direction": "almost a smile, then not",
        "characters": 9
      },
      {
        "lineId": "S1-05-L007",
        "cue": "GIDEON",
        "voiceId": null,
        "text": "He can't ask. He has no standing. You know that.",
        "direction": "gently",
        "characters": 48
      },
      {
        "lineId": "S1-05-L008",
        "cue": "SLOANE",
        "voiceId": null,
        "text": "I know.",
        "direction": null,
        "characters": 7
      },
      {
        "lineId": "S1-05-L009",
        "cue": "SLOANE",
        "voiceId": null,
        "text": "Every year I tell myself I'll stop deciding who gets what. Every year I'm very good at it.",
        "direction": null,
        "characters": 90
      },
      {
        "lineId": "S1-05-L010",
        "cue": "GIDEON",
        "voiceId": null,
        "text": "Want me to send it back?",
        "direction": null,
        "characters": 24
      },
      {
        "lineId": "S1-05-L011",
        "cue": "SLOANE",
        "voiceId": null,
        "text": "No.",
        "direction": "a beat",
        "characters": 3
      },
      {
        "lineId": "S1-05-L012",
        "cue": "GIDEON",
        "voiceId": null,
        "text": "Then I'll be downstairs.",
        "direction": null,
        "characters": 24
      }
