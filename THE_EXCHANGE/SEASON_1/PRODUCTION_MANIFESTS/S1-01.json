        "wardrobe": {},
        "props": {},
        "framing": "WIDE",
        "blocking": "A street of brownstones and glass towers at dusk. Copper light on the stoops. Windows come on one by one, like a city putting on its earrings."
      },
      {
        "shotId": "S1-01-SC02-SH01",
        "frame": "S1-01-SC02-SH01.start",
        "setRef": "SET-CITY-DUSK › TAILOR'S SHOPFRONT",
        "onScreen": [
          "TAILOR"
        ],
        "wardrobe": {},
        "props": {},
        "framing": "WIDE",
        "blocking": "A tailor in shirtsleeves lowers the grille on his shop. Halfway down he stops, ducks under, and straightens the lapel on the mannequin in the window. Then he locks up and pats the glass goodnight."
      },
      {
        "shotId": "S1-01-SC03-SH01",
        "frame": "S1-01-SC03-SH01.start",
        "setRef": "SET-CITY-DUSK › BUS STOP",
        "onScreen": [
          "TEENAGER"
        ],
        "wardrobe": {},
        "props": {},
        "framing": "WIDE",
        "blocking": "A teenager at the bus stop practises a dance step in the reflection of the shelter glass. Wrong. Wrong. Right. Nobody is watching, so he does it again for the pleasure of it."
      },
      {
        "shotId": "S1-01-SC04-SH01",
        "frame": "S1-01-SC04-SH01.start",
        "setRef": "SET-CITY-DUSK › FIRE ESCAPE",
        "onScreen": [
          "GRANDMOTHER"
        ],
        "wardrobe": {},
        "props": {},
        "framing": "WIDE",
        "blocking": "A grandmother hangs a jewel-green dress on her fire escape to air. She smooths the skirt with both hands and gives it a long look, as if the dress has a date tonight and she approves of him."
      },
      {
        "shotId": "S1-01-SC05-SH01",
        "frame": "S1-01-SC05-SH01.start",
        "setRef": "SET-CITY-DUSK › BALCONY KITCHEN",
        "onScreen": [
          "WOMAN ON THE BALCONY"
        ],
        "wardrobe": {},
        "props": {},
        "framing": "WIDE",
        "blocking": "Through an open balcony door, a woman dances alone in her kitchen. A wooden spoon for a partner. Completely unembarrassed."
      },
      {
        "shotId": "S1-01-SC06-SH01",
        "frame": "S1-01-SC06-SH01.start",
