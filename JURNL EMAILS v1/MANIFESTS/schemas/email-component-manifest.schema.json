{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jurnl-emails-v1/email-component-manifest.schema.json",
  "title": "JURNL email components",
  "type": "object",
  "required": [
    "id",
    "system",
    "collection",
    "sprint",
    "schema",
    "generated_by",
    "source",
    "components"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "system": {
      "const": "JURNL EDITORIAL CORRESPONDENCE"
    },
    "collection": {
      "const": "JURNL EMAILS v1"
    },
    "sprint": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "type": "string",
      "minLength": 1
    },
    "generated_by": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "families",
          "consent_classes",
          "html",
          "image",
          "dynamic_data",
          "forbidden"
        ],
        "properties": {
          "id": {
            "pattern": "^EC\\d{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "families": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "consent_classes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "html": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "image": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dynamic_data": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbidden": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
