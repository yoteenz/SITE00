  "may_not_casually_change": [
    "PRIMARY_COMPOSITION",
    "PRIMARY_OBJECT",
    "PRIMARY_AXIS",
    "METAPHOR",
    "SPATIAL_LOGIC",
    "CORE_HIERARCHY",
    "MAJOR_ZONES",
