 "verdicts": {
  "auth": {
   "auth": "FAIL",
   "reason": "Identity (Supabase JWT) is real and admin APIs under api/admin/* are server-enforced, but there is no role/membership model, no project invite flow, password reset cannot complete, client roles are request-spoofable, and a large set of generation/mutation endpoints are unauthenticated. Not client-ready."
  },
  "registry": "FAIL",
  "firewall": {
   "client_project_firewall": "FAIL",
   "reason": "Host/project UI separation is well built for JURNL (scoped CSS, lazy registry, tests). But the data firewall is not enforced: RLS is service_role-only (no per-project/member policies) and two tables are open to anon. ~20 API endpoints take a project id from the caller with no auth. Client roles are request-spoofable, and all projects share one public storage bucket. Project data and canon can be read or changed across projects by an unauthenticated caller."
  },
  "review_loop": {
   "review_send": {
    "verdict": "FAIL",
    "reason": "No production code creates site00_client_review_objects or moves deliverables/approvals to CLIENT_REVIEW; only preview fixture seeding."
   },
   "client_approval": {
    "verdict": "PARTIAL",
    "reason": "Durable approve endpoint with receipts/idempotency exists, but client hooks send no Bearer token (401 in prod), role is client-tamperable, and there are no real review objects to approve."
   },
