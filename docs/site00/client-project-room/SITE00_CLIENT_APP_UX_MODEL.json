{
 "artifact": "SITE00_CLIENT_APP_UX_MODEL",
 "sprint": "P0.SITE00.CLIENT-PROJECT-ROOM-UX-APPROVAL-COST-TRANSPARENCY-FORENSIC1",
 "status": "PROPOSED_BY_OPUS (plan only \u2014 0 code, 0 DB changes)",
 "commit": "eedc9c81abfb9d80b058bd423978af72089c9481",
 "principle": "Private project room \u00b7 guided journey \u00b7 clear window into the work \u00b7 trust layer. Not a task manager, developer dashboard, production console, accounting app or wall of status cards.",
 "client_jobs": [
  "REVIEW",
  "APPROVE",
  "EXPLAIN REVISIONS",
  "ANSWER REQUIRED QUESTIONS",
  "PROVIDE REQUIRED MATERIALS",
  "FUND REQUIRED THIRD-PARTY COSTS (where applicable)"
 ],
 "questions_the_room_must_answer": [
  "WHERE ARE WE?",
  "WHAT IS HAPPENING NOW?",
  "WHAT IS WAITING ON ME?",
  "WHAT HAVE I APPROVED?",
  "WHAT DID I REQUEST CHANGES TO?",
  "WHAT COMES NEXT?",
  "WHAT WILL THE NEXT STEP REQUIRE?",
  "WHAT WILL THE NEXT STEP COST?",
  "HOW MUCH HAS BEEN SPENT?",
  "WHAT FILES ARE MINE?",
  "WHAT DOES THE FOUNDER NEED FROM ME?"
 ],
 "answer_location": {
  "WHERE ARE WE?": "HOME.CurrentMoment",
  "WHAT IS WAITING ON ME?": "HOME.NeedsYou",
  "WHAT HAVE I APPROVED?": "HOME.RecentlyApproved + REVIEWS.APPROVED",
  "WHAT DID I REQUEST CHANGES TO?": "REVIEWS.REVISION IN PROGRESS",
  "WHAT COMES NEXT? / REQUIRE? / COST?": "HOME.Next + NextFamilyAdvance",
  "HOW MUCH HAS BEEN SPENT?": "HOME.CostSnapshot + PROJECT.CostCenter",
  "WHAT FILES ARE MINE?": "LIBRARY",
  "WHAT DOES THE FOUNDER NEED FROM ME?": "HOME.NeedsYou + INBOX.REQUESTS"
 },
 "home": {
  "order": [
   "CURRENT MOMENT",
   "NEEDS YOU",
   "NEXT",
   "RECENTLY APPROVED",
   "COST SNAPSHOT",
   "PROJECT UPDATES"
  ],
  "rules": [
   "NEEDS YOU collapses to one quiet line when empty (\"NOTHING NEEDS YOU \u2014 WE'RE IN PRODUCTION ON FAMILY 02\")",
   "No metrics without meaning; no fake numbers",
   "Never more than one primary button above the fold"
  ]
 },
 "project": {
  "order": [
   "SUMMARY",
   "JOURNEY",
   "FAMILY ROADMAP",
   "TIMELINE",
   "COST CENTER",
   "UPDATES"
  ]
 },
 "reviews": {
  "groups": [
   "NEEDS YOU",
   "REVISION IN PROGRESS",
   "APPROVED"
  ],
  "not": "a table of tickets"
 },
 "inbox": "Human conversation only; status never requires a message.",
 "library": "Clean archive; never exposes the internal asset vault.",
 "mobile": {
  "primary_viewport": "393\u00d7852",
  "secondary": [
   "834\u00d71194",
   "1440\u00d7900"
  ],
  "rules": [
   "Review fully completable on a phone",
   "Decision controls \u226548px, labelled, thumb-reachable, not swipe",
   "Keyboard never covers prompt, field or submit (focused sheet with sticky submit above keyboard)"
  ]
 },
 "components": [
  {
   "component": "CurrentMoment",
   "shows": [
    "project status word (ON TRACK / WAITING ON YOU / IN PRODUCTION / FUNDING NEEDED / COMPLETE)",
