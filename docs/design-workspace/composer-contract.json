  "ASYNC_STATES": {
    "vocabulary": [
      "IDLE",
      "LOADING",
      "SUCCESS",
      "ERROR",
      "EMPTY",
      "BLOCKED",
      "DISABLED",
      "OFFLINE",
      "PROVIDER_FAILURE",
      "STALE",
      "UNKNOWN",
      "MISSING"
    ],
    "rule": "no fabricated value may appear in place of a missing one, on any status surface",
    "generation": {
      "concurrency": "at most one generation in flight per workspace",
      "disabledWhen": [
        "no candidate selected",
        "authorityPair is PAIR_LOCKED",
        "generationState is LOADING",
        "FAL_KEY absent"
      ]
    },
    "moveToBuild": "BLOCKED in every currently reachable state — scopedCompilerReadiness hardcodes buildPass = false"
  },
  "COST_GUARDS": {
    "costBearingElements": [
      "DW-CAND-001",
      "DW-CAND-002"
    ],
    "serverGuard": "endpoints require founderConfirmedSpend; runMobileTwinFalPipeline throws SPEND_GUARD without it",
    "gap": "client code currently sets founderConfirmedSpend: true automatically, satisfying the guard without a founder decision",
    "required": [
      "founderConfirmedSpend must originate from an explicit founder confirmation in the UI; Composer must not hardcode true",
      "REFINE confirms inside OV-REFINE alongside the bounded input",
      "REGENERATE confirms in a modal, having no input surface of its own",
      "both actions disable while a generation is in flight — this prevents unbounded generation loops",
      "provider failure is a first-class state and never creates a candidate",
      "cost accounting reuses MobileProviderCostRecord"
    ],
    "unresolved": "whether a per-session or per-project spend ceiling should exist — no budget cap exists in the architecture"
  },
