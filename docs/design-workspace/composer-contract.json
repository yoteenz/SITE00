  "VIEW_MODES": {
    "stateKey": "workspace.viewMode",
    "values": [
      "canonical",
      "list"
    ],
    "default": "canonical",
    "persistence": "sessionStorage:site00:twin-opus-direct:view-mode:v1",
    "sameRoute": true,
    "presentationOnly": true,
    "renderers": {
      "canonical": "TwinOpusDirectCanonicalView (Opus)",
      "list": "TwinOpusDirectListView (Spark, refined by Opus)"
    },
    "rule": "switching must not mutate any tier A or tier B state"
  },
  "STATE_MODEL": {
    "tiers": {
      "A": "workspace data — persisted, audited, shared",
      "B": "workspace focus — shared, not persisted",
      "C": "presentation — never affects data"
    },
    "keys": {
      "workspace.viewMode": {
        "tier": "C",
        "type": "union",
        "values": [
          "canonical",
          "list"
        ],
        "default": "canonical",
        "persistence": "sessionStorage"
      },
      "viewport": {
        "tier": "B",
        "type": "union",
        "values": [
          "MOBILE",
          "TABLET",
          "DESKTOP"
        ],
        "default": "MOBILE",
        "persistence": "none",
        "unresolved": "FD-05"
      },
      "selectedCandidate": {
        "tier": "B",
        "type": "id",
        "default": "first candidate",
        "persistence": "none"
      },
      "candidateCollection": {
        "tier": "A",
        "type": "array",
        "persistence": "session"
      },
      "viewportSelection": {
        "tier": "A",
        "type": "{ mobile: ref|null, desktop: ref|null }",
        "persistence": "session"
      },
      "candidateViewportStates": {
        "tier": "A",
        "type": "map",
        "values": [
          "GENERATED",
          "NOT_SELECTED",
          "SELECTED",
          "PROMOTED",
          "SUPERSEDED",
          "REJECTED"
        ],
        "persistence": "session"
      },
      "mobileMaster": {
        "tier": "A",
        "type": "ViewportMasterAuthority|null",
        "values": [
          "PROMOTED",
          "PAIR_LOCKED",
          "SUPERSEDED"
        ],
        "persistence": "session"
      },
      "desktopMaster": {
        "tier": "A",
        "type": "ViewportMasterAuthority|null",
        "values": [
          "PROMOTED",
          "PAIR_LOCKED",
          "SUPERSEDED"
        ],
        "persistence": "session"
      },
      "authorityPair": {
        "tier": "A",
        "type": "DesignWorkspaceAuthorityPair|null",
        "values": [
          "DRAFT",
          "MOBILE_ONLY",
          "DESKTOP_ONLY",
          "PAIR_READY",
          "PAIR_LOCKED",
          "DERIVATION_READY",
          "SUPERSEDED"
        ],
        "persistence": "session"
      },
      "authorityStatus": {
        "tier": "A",
        "type": "derived",
        "source": "pairStatusLabel(session)"
      },
      "authorityCollapsed": {
        "tier": "C",
        "type": "boolean",
        "default": false,
        "persistence": "none"
      },
      "readiness": {
        "tier": "A",
        "type": "CompilerReadinessReceipt",
        "persistence": "derived"
      },
      "checks": {
        "tier": "A",
        "type": "gate rows",
        "values": [
          "PASS",
          "FAIL",
          "BLOCKED",
          "NOT_APPLICABLE"
        ],
        "persistence": "derived"
      },
      "statusCounts": {
        "tier": "A",
        "type": "derived",
        "note": "blockers and warnings only; approved and pending are FD-07"
      },
      "currentHistoryTab": {
        "tier": "C",
        "type": "index 0-4",
        "default": 0,
        "persistence": "none"
      },
      "navSelection": {
        "tier": "B",
        "type": "index 0-5",
        "default": 0,
        "persistence": "url ?tab="
      },
      "dockSelection": {
        "tier": "C",
        "type": "index 0-4",
        "default": 0,
        "persistence": "none"
      },
      "currentStage": {
        "tier": "A",
        "type": "string",
        "persistence": "session"
      },
      "currentEntry": {
        "tier": "A",
        "type": "object",
        "persistence": "session"
      },
      "activeAmendment": {
        "tier": "A",
        "type": "MasterAuthorityAmendment|null",
        "values": [
          "DRAFT",
          "APPROVED",
          "APPLIED",
          "SUPERSEDED"
        ],
        "persistence": "session"
      },
      "generationState": {
        "tier": "B",
        "type": "union",
        "values": [
          "IDLE",
          "LOADING",
          "SUCCESS",
          "ERROR"
        ],
        "default": "IDLE",
        "persistence": "none"
      },
      "overlay": {
        "tier": "C",
        "type": "overlay id|null",
        "default": null,
        "persistence": "none"
      },
      "compareSelection": {
        "tier": "C",
        "type": "{ left, right }",
        "persistence": "none"
      }
    }
  },
