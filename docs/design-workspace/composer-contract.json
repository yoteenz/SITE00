    "criticalSemantics": {
      "DW-AUTH-001": "SELECT FOR MOBILE is reversible selection, NOT promotion",
      "DW-AUTH-014": "PROMOTE is candidate -> viewport master; the pair forms automatically from two masters",
      "DW-AUTH-013": "REPLACE is immediate, clears the slot, preserves lineage, dissolves the pair. No staged state.",
      "DW-AUTH-018": "LOCK is irreversible. No unlock function exists.",
      "DW-GAL-004": "the whole card selects; there is no double action",
      "DW-VP-002": "the viewport selector chooses the authority slot being operated on, not a preview size",
      "DW-PIPE-021": "PRIMARY ACTION is a derivation from workflow state, never hardcoded copy",
      "DW-DOCK-005": "CONTEXTUAL NEXT ACTION uses the same resolver as DW-PIPE-021"
    },
    "mockStringsThatContradictArchitecture": [
      {
        "shown": "82% readiness ring and five check labels",
        "reality": "compiler_readiness forbids fake metrics; real readiness is a PASS/FAIL/BLOCKED receipt",
        "decision": "FD-07"
      },
      {
        "shown": "APPROVED ELEMENTS 18 / PENDING DECISIONS 2",
        "reality": "no computation exists",
        "decision": "FD-07"
      },
      {
        "shown": "AMENDMENT status ACTIVE",
        "reality": "enum is DRAFT|APPROVED|APPLIED|SUPERSEDED; canonical record is APPROVED",
        "decision": "render the record"
      },
      {
        "shown": "AMENDMENT TYPE: AUTHORITY SELECTION",
        "reality": "amendmentType is FEATURE_ADDITION",
        "decision": "render the record"
      },
      {
        "shown": "MAA-RSF1-...",
        "reality": "canonical id is maa-r5f1-authority-selection-v1",
        "decision": "render the record"
      },
      {
        "shown": "PAIR: UNLOCKED",
        "reality": "not a member of the status union; closest true value is PAIR_READY",
        "decision": "render pairStatusLabel(session)"
      }
    ]
  },
